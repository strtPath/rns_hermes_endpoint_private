# Hermes for Reticulum — Environment Configuration
# Copy this file to .env and customize

# ═══════════════════════════════════════════════════════
# Reticulum Configuration
# ═══════════════════════════════════════════════════════

# Display name announced on the mesh network
RETICULUM_DISPLAY_NAME="Hermes for Reticulum"

# Path to store LXMF messages and identity
RETICULUM_STORAGE=~/.lxmf/storage

# LXMF stamp cost (bandwidth throttle — 8 is standard)
RETICULUM_STAMP_COST=8

# Path to Reticulum config directory (leave empty for default ~/.reticulum)
# RETICULUM_CONFIG=

# Periodic re-announce cadence in minutes (default: 30).
# The bridge re-announces its destination on the mesh this often so it stays
# discoverable as other nodes' path tables age out. 0 disables periodic
# re-announce (announce only at startup). The minimum positive value is
# 1 minute — a smaller cadence would spam the mesh and is rejected at
# startup. Change here, then restart the bridge to apply (or override live
# for the current run with /announce <min>, which enforces the same floor).
# RETICULUM_ANNOUNCE_INTERVAL=30

# ═══════════════════════════════════════════════════════
# Hermes Integration
# ═══════════════════════════════════════════════════════

# Path to hermes CLI binary (auto-detected if empty)
# HERMES_BIN=

# Timeout for Hermes processing (seconds)
HERMES_TIMEOUT=300

# ═══════════════════════════════════════════════════════
# Access Control
# ═══════════════════════════════════════════════════════
#
# SECURITY: Default is allowlist mode (ALLOW_ALL=false).
# Only addresses listed in ALLOWED_USERS can interact with the agent.
# Unauthorized requests receive an automatic rejection message
# WITHOUT invoking Hermes (zero token consumption).

# Allow all users to message the agent (true/false)
HERMES_RETICULUM_ALLOW_ALL=false

# Comma-separated LXMF hashes of allowed users (32 hex chars each)
# Example: HERMES_RETICULUM_ALLOWED_USERS=aa11bb22...,cc33dd44...,ee55ff66...
HERMES_RETICULUM_ALLOWED_USERS=

# Comma-separated LXMF hashes of blocked users (takes priority over allowlist)
# HERMES_RETICULUM_BLOCKED_USERS=

# ═══════════════════════════════════════════════════════
# Tool Emojis (optional)
# ═══════════════════════════════════════════════════════
#
# Tool activity on the mesh uses the same per-tool emoji the Telegram
# gateway shows. The table ships with the bridge; point this at a flat
# {"tool_name": "emoji"} JSON map to override entries (e.g. to re-sync
# after a Hermes update) without waiting for a bridge release.
#
# HERMES_TOOL_EMOJIS=~/.hermes/reticulum_tool_emojis.json

# ═══════════════════════════════════════════════════════
# Jev pre-gate triage (optional)
# ═══════════════════════════════════════════════════════
#
# With MESH_GATE_TRIAGE=allow_benign and an OPENROUTER_API_KEY (or
# TYPESAFE_API_KEY) in the gateway env, Jev may auto-allow routine,
# benign tool calls before the human approve/deny gate is offered.
# Anything sensitive, destructive, uncertain, or below MESH_GATE_TRIAGE_CONF
# still escalates to the human gate, and any Jev error or timeout fails
# open to the human gate.
#
#   off          (default) gate works exactly as before
#   hint_only    Jev classifies + logs a hint, verdict is IGNORED
#                (dry-run calibration; never changes the gate)
#   allow_benign Jev may auto-allow ROUTINE calls; everything else
#                still escalates to the human approve/deny gate
#
# MESH_GATE_TRIAGE=off
# MESH_GATE_TRIAGE_CONF=0.6
#
# RESERVED (inert): execute_code is ALWAYS human-gated — its opaque
# Python payload is only fed to Jev via a first-line excerpt, so the triage
# stage may DENY a clearly destructive call but can never auto-ALLOW it.
# MESH_GATE_TRIAGE_EXEC=0
