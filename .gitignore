# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
.pi/
*.swp
*.swo

# Environment / secrets
# .env.bak* covers timestamped backups (e.g. .env.bak.20260918221011); the
# narrow *.bak rule below does not match `.env.bak.<stamp>` because the
# extension is the stamp, not `bak`.
.env
.env.local
.env.*.local
.env.bak*
*.env.bak*
secrets/
identity-registry-local.txt

# Agent working documents (plans written by the `plan` skill).
# Working drafts, not published docs; the repo's public surface is docs/.
.hermes/

# Reticulum / LXMF runtime data
.reticular/
.lxmf/

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Generated at install time by install.sh (points the plugin shim at the venv)
plugins/reticulum/venv_path.txt

# Build artifacts
*.egg-info/
.venv/

# Backup files
*.bak

